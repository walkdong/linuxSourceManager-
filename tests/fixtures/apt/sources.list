# Debian/Ubuntu sources used by the apt plugin test-suite.
# Comments, blank lines and commented-out entries must all survive every edit.

deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian trixie main contrib

# a parked entry: enable() uncomments it, disable() re-comments it byte-identically
# deb http://archive.ubuntu.com/ubuntu noble universe

deb [arch=amd64 signed-by=/usr/share/keyrings/vendor.gpg] https://packages.microsoft.com/repos/code stable main
